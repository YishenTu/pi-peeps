{
  "name": "pi-peeps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subagents for Pi: delegate to background Pi sessions, message them, and watch their threads live.",
  "license": "MIT",
  "author": "Yishen Tu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YishenTu/pi-peeps.git"
  },
  "homepage": "https://github.com/YishenTu/pi-peeps#readme",
  "bugs": {
    "url": "https://github.com/YishenTu/pi-peeps/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:tui": "python3 test/tui-smoke.py \"$(command -v node)\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "@types/node": "22.19.19"
  }
}
